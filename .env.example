# ==============================================================================
# yasamarium/llmserver Environment Configuration
# ==============================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=8000

# Security: Secret Bearer Token for API Authentication (Clients pass: Authorization: Bearer <API_KEY>)
# Set a strong, random key in production (e.g. openssl rand -hex 32)
API_KEY=your-secret-api-key-here

# Model Identification & Storage
MODEL_NAME=qwen3-4b
MODEL_FILE=qwen3-4b-instruct-q4_k_m.gguf
MODEL_PATH=models/qwen3-4b-instruct-q4_k_m.gguf

# Model Download Source (Hugging Face direct GGUF download URL)
MODEL_URL=https://huggingface.co/bartowski/Qwen_Qwen3-4B-Instruct-2507-GGUF/resolve/main/Qwen_Qwen3-4B-Instruct-2507-Q4_K_M.gguf
# Optional SHA-256 checksum for download verification (leave empty to skip check)
MODEL_SHA256=

# CPU Performance & Inference Tuning (Optimized for GitHub Actions standard runner: 2-4 vCPUs, 7GB RAM)
THREADS=2
CONTEXT_SIZE=2048
BATCH_SIZE=512
MAX_TOKENS=512
TEMPERATURE=0.7

# Development & Testing: Set to 'true' or '1' to simulate inference without downloading GGUF weights
MOCK_MODEL=false

# Lifecycle & Restart Settings (Workflow-controlled in-runner restart interval in seconds: 5 hours = 18000s)
RESTART_INTERVAL_SECONDS=18000

# Optional Public Tunneling Configuration
# Provide CLOUDFLARE_TUNNEL_TOKEN if you have a Cloudflare Named Tunnel (gives fixed domain like api.yourdomain.com)
# Leave empty to use Cloudflare Quick Tunnel (automatically provides a public https://*.trycloudflare.com URL)
CLOUDFLARE_TUNNEL_TOKEN=

# Optional Workflow Automation & Cross-Repo Sync
# GitHub Personal Access Token (PAT) with repo/workflow permissions
GH_PAT=
GITHUB_REPOSITORY=yasamarium/llmserver
TARGET_REPO=yasamarium/llm
